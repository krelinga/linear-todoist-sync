# Personal API token: https://linear.app/settings/account/security
LINEAR_API_KEY=

# Personal API token: https://app.todoist.com/app/settings/integrations/developer
TODOIST_API_TOKEN=

# How often to run the reconciliation poll, in seconds.
POLL_INTERVAL_SECONDS=60

# Local time (24-hour HH:MM) at which the daily digest comment runs.
DIGEST_TIME=07:00

# IANA time zone the digest time above is interpreted in.
DIGEST_TIMEZONE=America/Chicago

# Port the /metrics endpoint (Prometheus text format) listens on.
METRICS_PORT=9464

# --- Todoist project colours per Linear state (docs/design/project-colors-design.md) ---------
# Gives each specific "started" state its own Todoist project colour, so the Todoist sidebar
# reads as a status board. Entries are "State Name=color", comma separated. State names are
# matched case-insensitively against Linear's own names, and each entry splits on its LAST "="
# so a state name may contain one.
#
# Leave empty to colour nothing: every project then takes the default below. State names are
# NOT verified against Linear at startup - a state Linear uses that is missing here shows up in
# the sync_state_color_unmapped metric instead.
#
# Valid colours (Todoist's fixed palette): berry_red, red, orange, yellow, olive_green,
# lime_green, green, mint_green, teal, sky_blue, light_blue, blue, grape, violet, lavender,
# magenta, salmon, charcoal, grey, taupe
LINEAR_STATE_COLORS=

# Colour used for a started state not listed above. Defaults to charcoal.
LINEAR_STATE_COLOR_DEFAULT=

# --- Linear webhooks (optional; see docs/design/linear-webhooks-design.md) -------------------
# Leave LINEAR_WEBHOOK_SECRET empty to run poll-only, exactly as before. Setting any of the
# other WEBHOOK_* variables without it is a startup error rather than a silent no-op, because
# that combination always means someone believed the receiver was running when it was not.

# Signing secret shown by Linear when you create the webhook (Settings -> API -> Webhooks).
# Create it in the browser: managing webhooks needs workspace-admin rights, and keeping that
# step in the UI is what keeps an admin-scoped token out of this container.
LINEAR_WEBHOOK_SECRET=

# Port the webhook receiver listens on. Must differ from METRICS_PORT - only this one is ever
# exposed publicly, via Tailscale Funnel.
WEBHOOK_PORT=9465

# Path the receiver answers on. Must match both the URL registered in Linear and the Funnel
# serve config.
WEBHOOK_PATH=/webhooks/linear

# How long to wait before acting on a delivery, so a burst of edits collapses into one cycle.
WEBHOOK_DEBOUNCE_MS=2000

# --- Tailscale sidecar (only used by docker-compose.webhook.yml) -----------------------------
# Auth key for the Funnel node. Use a TAGGED key (tag:webhook-ingress): tagged nodes do not
# expire, while user-owned ones do after 180 days, which would silently take the Funnel down.
TS_AUTHKEY=
